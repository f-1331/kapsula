    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "deploy:tg": "npm run build && node ./node_modules/@tgcloud/cli/bin/tgcloud.js push",
    "generate:catalog": "node ./scripts/generate-manifest.mjs",
